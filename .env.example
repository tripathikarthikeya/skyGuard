# SkyGuard AI - Environment Variables
# Copy this file to .env and set your connection values.

# TimescaleDB / Tiger Cloud PostgreSQL Connection URI
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
TIMESCALE_SERVICE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Server Configuration
HOST=127.0.0.1
PORT=8000